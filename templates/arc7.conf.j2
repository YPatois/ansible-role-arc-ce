#
# ARC Computing Element zero configuration
# Consult ARC Installation Guide to modify this configuration for production use-cases
#

[common]
hostname={{ ansible_fqdn }}
x509_host_key = {{ arc_x509_user_key }}
x509_host_cert = {{ arc_x509_user_cert }}
x509_cert_dir = {{ arc_x509_cert_dir }}
voms_processing = standard

# Authgroups for VOs
{% for vo in gridsite_supported_vos %}
[authgroup: {{ vo }}]
voms = {{ vo }} * * *

{% endfor %}

# Authgroups for roles
{% for vo in gridsite_supported_vos_data_list %}
{% for mapping in vo.roles %}
[authgroup: {{ mapping.arcgroup }}]
{% if '=' in mapping.fqan %}
voms = {{ vo.name }} * {{ mapping.fqan.split('=')[1] }} *
{% else %}
voms = {{ vo.name }} {{ mapping.fqan }} * *
{% endif %}
{% if mapping.tokens is defined %}
{% for token in mapping.tokens %}
authtokens = {{ token }}
{% endfor %}
{% endif %}
{% endfor %}

{% endfor %}

[authgroup: allvos]
{% for vo in gridsite_supported_vos %}
authgroup = {{ vo }}
{% endfor %}

[mapping]
# Mapping from roles
{% for vo in gridsite_supported_vos_data_list %}
{% for mapping in vo.roles %}
{% if mapping.base_uid is not defined  %}
map_to_user = {{ mapping.arcgroup }} {{ mapping.pool_accounts.0.account }}:{{ vo.name }}
{% else %}
map_to_pool = {{ mapping.arcgroup }} /etc/grid-security/pools/{{ mapping.arcgroup }}
{% endif %}
{% endfor %}
{% endfor %}

# Mapping from VOs
{% for vo in gridsite_supported_vos %}
map_to_pool = {{ vo }} /etc/grid-security/pools/{{ vo }}
{% endfor %}

policy_on_nomap=stop

[lrms]
lrms = slurm
slurm_use_sacct = yes
benchmark=HEPscore23 14.64

[arex]
sessiondir = {{ arc_frontend_sessiondir }}
scratchdir = /var/tmp

[arex/data-staging]
#loglevel = INFO
globus_tcp_port_range = 24000,25000
globus_udp_port_range = 24000,25000
httpgetpartial = yes

[arex/ws]

[arex/ws/jobs]
{% for vo in gridsite_supported_vos_data_list %}
allowaccess = {{ vo.name }}
{% for mapping in vo.roles %}
allowaccess = {{ mapping.arcgroup }}
{% endfor %}

{% endfor %}

[arex/jura]
logfile = /var/log/arc/jura.log
loglevel = INFO
urdelivery_frequency = 3600
x509_host_key = {{ arc_x509_user_key }}
x509_host_cert = {{ arc_x509_user_cert }}
x509_cert_dir = {{ arc_x509_cert_dir }}

[arex/jura/apel: EGI]
targeturl = https://msg.argo.grnet.gr
gocdb_name=IN2P3-IRES

[infosys]

[infosys/ldap]
[infosys/nordugrid]

[infosys/glue2]
admindomain_name = IN2P3-IRES
#admindomain_distributed = no
computingservice_qualitylevel = testing

[infosys/cluster]
cluster_location=IPHC/CNRS, 23, rue du Loess, Strasbourg, France
architecture = x86_64
opsys=Almalinux-9
opsys=Linux
nodecpu = adtof
#nodememory=2048
nodeaccess = inbound
nodeaccess = outbound
#maxcputime = 172800
#maxwalltime = 172800

{% for vo in gridsite_supported_vos %}
advertisedvo = {{ vo }}
{% endfor %}

{% for vo in gridsite_supported_vos_data_list %}
[queue:{{ vo.name }}]
comment = Dedicated queue for {{ vo.name }}
allowaccess = {{ vo.name }}
{% for mapping in vo.roles %}
allowaccess = {{ mapping.arcgroup }}
{% endfor %}
advertisedvo = {{ vo.name }}
benchmark=HEPscore23 14.64

{% endfor %}

